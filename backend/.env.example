# 后端环境变量示例

> 复制此文件为 `.env` 并根据实际情况填写值
> 注意：不要将包含真实值的 `.env` 提交到版本控制

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/chemistry_lab

# JWT 配置
SECRET_KEY=your-super-secret-key-here-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 应用配置
DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:3100"]

# PostgreSQL 配置（Docker Compose 使用）
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=chemistry_lab
